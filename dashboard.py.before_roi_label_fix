    )


# ============================================================
# INITIAL DISPLAY
# ============================================================

update_statistics()

update_quality()

update_graph()

update_history()

update_diagnostics()


if not st.session_state.running:

    if st.session_state.bpm_locked:

        camera_box.success(
            "Measurement complete. "
            "Click New Measurement to measure again."
        )

    else:

        camera_box.info(
            "Camera stopped. "
            "Click Start to begin."
        )


# ============================================================
# LIVE MEASUREMENT
# ============================================================

if st.session_state.running:

    camera = (
        st.session_state.camera
    )

    detector = (
        st.session_state.detector
    )

    while st.session_state.running:

        # ====================================================
        # READ CAMERA
        # ====================================================

        success, frame = (
            camera.read()
        )

        if not success:

            time.sleep(
                0.02
            )

            continue

        current_time = (
            time.perf_counter()
        )

        frame = cv2.flip(
            frame,
            1
        )

        # ====================================================
        # FACE DETECTION
        # ====================================================

        try:

            face_landmarks = (
                detector.detect(
                    frame
                )
            )

        except Exception as e:

            face_landmarks = None

            print(
                "Face detection error:",
                e
            )

        roi_found = False

        green_value = None

        # ====================================================
        # FOREHEAD ROI
        # ====================================================

        if face_landmarks is not None:

            roi_result = (
                get_forehead_roi(
                    frame,
                    face_landmarks
                )
            )

            if roi_result is not None:

                (
                    roi,
                    x,
                    y,
                    x2,
                    y2,
                    eye_box
                ) = roi_result

                roi_found = True

                st.session_state.last_face_time = (
                    current_time
                )

                st.session_state.face_was_lost = (
                    False
                )

                # ============================================
                # IRIS DETECTION AND APPROXIMATE COLOUR ESTIMATION
                # ============================================
                landmarks = face_landmarks.landmark
                frame_h, frame_w = frame.shape[:2]

                iris_groups = {
                    "LEFT IRIS": [474, 475, 476, 477],
                    "RIGHT IRIS": [469, 470, 471, 472],
                }

                # Put labels in separate rows above the eyes.
                label_rows = {
                    "LEFT IRIS": 28,
                    "RIGHT IRIS": 48,
                }

                for eye_name, indices in iris_groups.items():
                    try:
                        points = np.asarray([
                            (
                                int(landmarks[idx].x * frame_w),
                                int(landmarks[idx].y * frame_h)
                            )
                            for idx in indices
                        ], dtype=np.int32)

                        cx = int(np.mean(points[:, 0]))
                        cy = int(np.mean(points[:, 1]))

                        # Approximate iris radius from its landmark spread.
                        distances = np.linalg.norm(
                            points - np.array([cx, cy]), axis=1
                        )
                        radius = max(2, int(np.max(distances) * 0.85))

                        # Sample a central circular region, not a square
                        # containing as much surrounding eyelid/skin.
                        yy, xx = np.ogrid[
                            max(0, cy - radius):min(frame_h, cy + radius + 1),
                            max(0, cx - radius):min(frame_w, cx + radius + 1)
                        ]

                        x1 = max(0, cx - radius)
                        y1 = max(0, cy - radius)
                        x2 = min(frame_w, cx + radius + 1)
                        y2 = min(frame_h, cy + radius + 1)

                        crop = frame[y1:y2, x1:x2]
                        if crop.size == 0:
                            continue

                        mask = (
                            (xx - cx) ** 2 + (yy - cy) ** 2
                            <= radius ** 2
                        )

                        hsv = cv2.cvtColor(crop, cv2.COLOR_BGR2HSV)
                        pixels = hsv[mask]

                        # Remove very dark pupil pixels and bright reflections.
                        pixels = pixels[
                            (pixels[:, 2] >= 35) &
                            (pixels[:, 2] <= 235) &
                            (pixels[:, 1] >= 25)
                        ]

                        colour = "UNCLEAR"

                        # A webcam crop this small is not always sufficient
                        # for a trustworthy iris-colour estimate.
                        if len(pixels) >= 5:
                            hue = float(np.median(pixels[:, 0]))
                            sat = float(np.median(pixels[:, 1]))
                            val = float(np.median(pixels[:, 2]))

                            if sat < 35:
                                colour = "UNCLEAR"
                            elif hue < 10 or hue >= 170:
                                colour = "BROWN/AMBER"
                            elif hue < 20:
                                colour = "BROWN"
                            elif hue < 35:
                                colour = "HAZEL/BROWN"
                            elif hue < 85:
                                colour = "GREENISH"
                            elif hue < 130:
                                colour = "BLUISH"
                            else:
                                colour = "UNCLEAR"

                        # Stabilise the label using the last  nine valid frames.
                        history = st.session_state.iris_colour_history[eye_name]
                        if colour != "UNCLEAR":
                            history.append(colour)
                            del history[:-9]

                        if history:
                            colour = max(set(history), key=history.count)

                        if show_roi:
                            cv2.circle(
                                frame, (cx, cy), radius,
                                (255, 255, 0), 2
                            )

                            # Store each eye's colour and draw both together.
                            display_colours = st.session_state.setdefault(
                                "iris_display_colours",
                                {"LEFT IRIS": "DETECTING",
                                 "RIGHT IRIS": "DETECTING"}
                            )
                            display_colours[eye_name] = colour

                            font = cv2.FONT_HERSHEY_SIMPLEX
                            scale = 0.46
                            thickness = 1
                            rows = [
                                f"LEFT IRIS: {display_colours['LEFT IRIS']}",
                                f"RIGHT IRIS: {display_colours['RIGHT IRIS']}"
                            ]
                            sizes = [
                                cv2.getTextSize(row, font, scale, thickness)[0]
                                for row in rows
                            ]
                            panel_w = max(size[0] for size in sizes) + 18
                            px = max(8, frame_w - panel_w - 12)
                            py = 12
                            cv2.rectangle(
                                frame, (px, py), (px + panel_w, py + 58),
                                (20, 20, 20), -1
                            )
                            cv2.rectangle(
                                frame, (px, py), (px + panel_w, py + 58),
                                (255, 255, 0), 1
                            )
                            cv2.putText(
                                frame, rows[0], (px + 8, py + 23),
                                font, scale, (255, 255, 0),
                                thickness, cv2.LINE_AA
                            )
                            cv2.putText(
                                frame, rows[1], (px + 8, py + 45),
                                font, scale, (255, 255, 0),
                                thickness, cv2.LINE_AA
                            )

                    except (IndexError, ValueError, cv2.error):
                        continue

                # DRAW FOREHEAD ROI
                # ============================================

                if show_roi:

                    ex, ey, ex2, ey2 = eye_box
                    cv2.rectangle(
                        frame,
                        (ex, ey),
                        (ex2, ey2),
                        (255, 0, 0),
                        2
                    )
                    cv2.putText(
                        frame,
                        "EYES DETECTED",
                        (ex, max(20, ey - 8)),
                        cv2.FONT_HERSHEY_SIMPLEX,
                        0.5,
                        (255, 0, 0),
                        2
                    )

                    cv2.rectangle(
                        frame,
                        (x, y),
                        (x2, y2),
                        (0, 255, 0),
                        2
                    )

                    cv2.putText(
                        frame,
                        "FOREHEAD ROI",
                        (
                            x,
                            max(
                                30,
                                y - 10
                            )
                        ),
                        cv2.FONT_HERSHEY_SIMPLEX,
                        0.6,
                        (0, 255, 0),
                        2
                    )

                # ============================================
                # GREEN CHANNEL
                # ============================================

                green_value = (
                    extract_green_value(
                        roi
                    )
                )

                rgb_value = extract_rgb_values(roi)

                # ============================================
                # COLLECT SIGNAL ONLY UNTIL BPM LOCKS
                # ============================================

                if (
                    green_value is not None
                    and
                    not st.session_state.bpm_locked
                ):

                    st.session_state.signal_buffer.append(
                        green_value
                    )

                    st.session_state.rgb_buffer.append(rgb_value)

                    st.session_state.timestamp_buffer.append(
                        current_time
                    )

                    if (
                        len(
                            st.session_state.signal_buffer
                        )
                        >
                        MAX_SAMPLES
                    ):

                        st.session_state.signal_buffer.pop(
                            0
                        )

                        st.session_state.timestamp_buffer.pop(0)

                        if st.session_state.rgb_buffer:
                            st.session_state.rgb_buffer.pop(0)

        # ====================================================
        # FACE LOST HANDLING
        # ====================================================

        if (
            not roi_found
            and
            not st.session_state.bpm_locked
        ):

            lost_duration = (
                current_time
                -
                st.session_state.last_face_time
            )

            if (
                lost_duration
                >
                FACE_LOST_RESET_SECONDS
                and
                not st.session_state.face_was_lost
            ):

                print(
                    "Face lost too long. "
                    "Signal measurement reset."
                )

                st.session_state.signal_buffer = []

                st.session_state.timestamp_buffer = []

                st.session_state.rgb_buffer = []

                st.session_state.candidate_bpms = []

                st.session_state.raw_bpm = None

                st.session_state.actual_fps = None

                st.session_state.last_bpm_time = 0.0

                st.session_state.face_was_lost = (
                    True
                )

        # ====================================================
        # ACTUAL TIMESTAMP FPS
        # ====================================================

        if not st.session_state.bpm_locked:

            st.session_state.actual_fps = (
                calculate_actual_fps(
                    st.session_state.timestamp_buffer
                )
            )

        # ====================================================
        # DRAW CAMERA INFORMATION
        # ====================================================

        sample_count = len(
            st.session_state.signal_buffer
        )

        cv2.putText(
            frame,
            (
                f"Samples: "
                f"{sample_count}/"
                f"{required_samples}"
            ),
            (25, 40),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.65,
            (255, 255, 255),
            2
        )

        # Smooth displayed parameters only; keep raw measurements unchanged.
        if "display_fps_smooth" not in st.session_state:
            st.session_state.display_fps_smooth = None
        if "display_green_smooth" not in st.session_state:
            st.session_state.display_green_smooth = None

        actual_fps = st.session_state.actual_fps
        if actual_fps is not None:
            previous_fps = st.session_state.display_fps_smooth
            st.session_state.display_fps_smooth = (
                actual_fps if previous_fps is None
                else 0.15 * actual_fps + 0.85 * previous_fps
            )
            actual_fps = st.session_state.display_fps_smooth

        if green_value is not None:
            previous_green = st.session_state.display_green_smooth
            st.session_state.display_green_smooth = (
                green_value if previous_green is None
                else 0.15 * green_value + 0.85 * previous_green
            )
            green_value = st.session_state.display_green_smooth

        if actual_fps is not None:

            cv2.putText(
                frame,
                (
                    f"FPS: "
                    f"{actual_fps:.1f}"
                ),
                (25, 70),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.55,
                (255, 220, 0),
                2
            )

        if green_value is not None:

            cv2.putText(
                frame,
                (
                    f"Green: "
                    f"{green_value:.2f}"
                ),
                (25, 100),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.55,
                (0, 255, 255),
                2
            )

        # ====================================================
        # BPM ESTIMATION
        # ====================================================

        now = time.time()

        if (
            not st.session_state.bpm_locked
            and
            len(
                st.session_state.signal_buffer
            )
            >=
            required_samples
            and
            st.session_state.actual_fps
            is not None
            and
            (
                now
                -
                st.session_state.last_bpm_time
            )
            >=
            BPM_UPDATE_SECONDS
        ):

            # ================================================
            # ESTIMATE RAW BPM
            # ================================================

            try:

                estimated_bpm = (
                    estimate_bpm(
                        st.session_state.signal_buffer,
                        st.session_state.actual_fps
                    )
                )

                # Experimental CHROM comparison; green remains the live estimate.
                chrom_bpm = estimate_chrom_bpm(
                    st.session_state.rgb_buffer,
                    st.session_state.actual_fps
                )

                if chrom_bpm is not None:
                    print(
                        f"EXPERIMENTAL CHROM BPM={chrom_bpm:.1f} | "
                        f"GREEN BPM={estimated_bpm}"
                    )

            except Exception as e:

                print(
                    "estimate_bpm ERROR:",
                    repr(e)
                )

                estimated_bpm = None

            # ================================================
            # DIAGNOSTICS
            # ================================================

            arr = np.asarray(
                st.session_state.signal_buffer,
                dtype=np.float64
            )

            if estimated_bpm is None:

                st.session_state.raw_bpm = (
                    None
                )

                print(
                    "Estimator returned None | "
                    f"FPS="
                    f"{st.session_state.actual_fps:.2f} | "
                    f"Samples={len(arr)} | "
                    f"Mean={np.mean(arr):.2f} | "
                    f"STD={np.std(arr):.4f} | "
                    f"Range={np.ptp(arr):.4f}"
                )

            else:

                raw_bpm = float(
                    estimated_bpm
                )

                st.session_state.raw_bpm = (
                    raw_bpm
                )

                print(
                    f"Raw BPM={raw_bpm:.1f} | "
                    f"FPS="
                    f"{st.session_state.actual_fps:.2f} | "
                    f"Samples={len(arr)} | "
                    f"STD={np.std(arr):.4f} | "
                    f"Range={np.ptp(arr):.4f}"
                )

                # ============================================
                # ADD CANDIDATE
                # ============================================

                accepted = (
                    add_bpm_candidate(
                        raw_bpm
                    )
                )

                if accepted:

                    print(
                        "Accepted BPM | "
                        f"Candidates="
                        f"{len(st.session_state.candidate_bpms)}"
                    )

                    # ========================================
                    # CHECK LOCK
                    # ========================================

                    possible_lock = (
                        check_bpm_lock()
                    )

                    if possible_lock is not None:

                        st.session_state.locked_bpm = (
                            possible_lock
                        )

                        st.session_state.current_bpm = (
                            possible_lock
                        )

                        st.session_state.bpm_locked = (
                            True
                        )

                        # Store one final BPM measurement
                        st.session_state.all_bpm.append(
                            possible_lock
                        )

                        st.session_state.history.append(
                            {
                                "Time":
                                    time.strftime(
                                        "%H:%M:%S"
                                    ),

                                "BPM":
                                    round(
                                        possible_lock,
                                        1
                                    ),

                                "Signal Quality":
                                    f"{calculate_quality()}%",

                                "Status":
                                    (
                                        "LOW"
                                        if possible_lock < 60
                                        else
                                        "NORMAL"
                                        if possible_lock <= 100
                                        else
                                        "HIGH"
                                    )
                            }
                        )

                        print()

                        print(
                            "=" * 55
                        )

                        print(
                            "MEASUREMENT COMPLETE"
                        )

                        print(
                            "FINAL LOCKED BPM: "
                            f"{possible_lock:.1f}"
                        )

                        print(
                            "=" * 55
                        )

                        print()

            st.session_state.last_bpm_time = (
                now
            )

        # ====================================================
        # CAMERA OVERLAY - BPM STATE
        # ====================================================

        if st.session_state.bpm_locked:

            locked = (
                st.session_state.locked_bpm
            )

            cv2.putText(
                frame,
                (
                    f"BPM: "
                    f"{locked:.1f}"
                ),
                (25, 140),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.8,
                (0, 255, 0),
                2
            )

            cv2.putText(
                frame,
                "MEASUREMENT COMPLETE",
                (25, 175),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.65,
                (0, 255, 0),
                2
            )

        elif (
            len(
                st.session_state.signal_buffer
            )
            <
            required_samples
        ):

            cv2.putText(
                frame,
                "BPM: Collecting signal...",
                (25, 140),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.6,
                (0, 255, 255),
                2
            )

        elif len(
            st.session_state.candidate_bpms
        ) == 0:

            cv2.putText(
                frame,
                "BPM: Analyzing...",
                (25, 140),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.6,
                (0, 255, 255),
                2
            )

        else:

            candidate_progress = min(
                len(
                    st.session_state.candidate_bpms
                ),
                LOCK_WINDOW
            )

            cv2.putText(
                frame,
                (
                    "BPM: Stabilizing "
                    f"{candidate_progress}/"
                    f"{LOCK_WINDOW}"
                ),
                (25, 140),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.6,
                (0, 255, 255),
                2
            )

        # ====================================================
        # DISPLAY CAMERA
        # ====================================================

        rgb_frame = cv2.cvtColor(
            frame,
            cv2.COLOR_BGR2RGB
        )

        camera_box.image(
            rgb_frame,
            channels="RGB",
            width="stretch"
        )

        # ====================================================
        # CAMERA STATUS
        # ====================================================

        if st.session_state.bpm_locked:

            camera_status.markdown(
                '<div class="complete">'
                '✓ Measurement complete • '
                'BPM successfully locked'
                '</div>',
                unsafe_allow_html=True
            )

        elif roi_found:

            camera_status.markdown(
                '<div class="detected">'
                '● Forehead detected • '
                'Signal collecting'
                '</div>',
                unsafe_allow_html=True
            )

        else:

            camera_status.markdown(
                '<div class="not-detected">'
                '● Face/forehead not detected • '
                'Look directly at the camera'
                '</div>',
                unsafe_allow_html=True
            )

        # ====================================================
        # MEASUREMENT STATUS
        # ====================================================

        if st.session_state.bpm_locked:

            measurement_status_box.markdown(
                '<div class="complete">'
                '✓ MEASUREMENT COMPLETE<br>'
                'Final heart rate has been locked.'
                '</div>',
                unsafe_allow_html=True
            )

        elif len(
            st.session_state.signal_buffer
        ) < required_samples:

            measurement_status_box.markdown(
                '<div class="stabilizing">'
                'Collecting pulse signal...'
                '</div>',
                unsafe_allow_html=True
            )

        elif len(
            st.session_state.candidate_bpms
        ) < LOCK_WINDOW:

            count = len(
                st.session_state.candidate_bpms
            )

            measurement_status_box.markdown(
                (
                    '<div class="stabilizing">'
                    'Stabilizing heart rate... '
                    f'{count}/{LOCK_WINDOW}'
                    '</div>'
                ),
                unsafe_allow_html=True
            )

        # ====================================================
        # UPDATE BPM CARD
        # ====================================================

        render_bpm(
            bpm_box
        )

        update_quality()

        update_statistics()

        update_diagnostics()

        # ====================================================
        # GRAPH / HISTORY
        # ====================================================

        if (
            now
            -
            st.session_state.last_graph_time
            >=
            GRAPH_UPDATE_SECONDS
        ):

            update_graph()

            update_history()

            st.session_state.last_graph_time = (
                now
            )

        # ====================================================
        # CPU CONTROL
        # ====================================================

        time.sleep(
            0.02
        )


# ============================================================
# FOOTER
# ============================================================

st.divider()

st.caption(
    "Heart Rate AI • Contactless rPPG Monitoring • "
    "Educational and Research Prototype"
)
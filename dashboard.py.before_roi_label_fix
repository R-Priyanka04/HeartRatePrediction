def update_quality():

    count = len(
        st.session_state.signal_buffer
    )

    quality = (
        calculate_quality()
    )

    if quality >= 80:

        label = "GOOD"

    elif quality >= 50:

        label = "FAIR"

    else:

        label = "LOW"

    quality_box.markdown(
        f"**Signal Quality:** "
        f"{label} • {quality}%"
    )

    # Once minimum samples are collected, progress represents
    # stabilization instead of raw sample collection.

    if count < required_samples:

        progress = min(
            count / required_samples,
            1.0
        )

        progress_text.caption(
            f"Signal collection: "
            f"{count}/{required_samples} samples"
        )

    elif not st.session_state.bpm_locked:

        candidate_count = len(
            st.session_state.candidate_bpms
        )

        progress = min(
            candidate_count
            /
            LOCK_WINDOW,
            1.0
        )

        progress_text.caption(
            f"BPM stabilization: "
            f"{candidate_count}/{LOCK_WINDOW} "
            f"accepted estimates"
        )

    else:

        progress = 1.0

        progress_text.caption(
            "✓ Measurement complete"
        )

    progress_bar.progress(
        float(progress)
    )


# ============================================================
# UPDATE GRAPH
# ============================================================

def update_graph():

    if not show_signal:

        graph_box.info(
            "Live signal display disabled."
        )

        return

    signal = (
        st.session_state.signal_buffer
    )

    if len(signal) < 2:

        graph_box.info(
            "Waiting for pulse signal..."
        )

        return

    # Keep only recent data
    recent_signal = signal[
        -MAX_SAMPLES:
    ]

    df = pd.DataFrame(
        {
            "Green Intensity":
                recent_signal
        }
    )

    graph_box.line_chart(
        df,
        height=270,
        width="stretch"
    )


# ============================================================
# UPDATE HISTORY
# ============================================================

def update_history():

    history = (
        st.session_state.history
    )

    if not history:

        history_box.info(
            "No completed BPM measurement yet."
        )

        return

    df = pd.DataFrame(
        history[-20:]
    )

    history_box.dataframe(
        df,
        width="stretch",
        hide_index=True
    )


# ============================================================
# UPDATE DIAGNOSTICS

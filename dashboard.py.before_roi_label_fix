# ============================================================
# ACTUAL FPS
# ============================================================

def calculate_actual_fps(timestamps):

    if timestamps is None:

        return None

    if len(timestamps) < 30:

        return None

    times = np.asarray(
        timestamps,
        dtype=np.float64
    )

    differences = np.diff(times)

    if len(differences) == 0:

        return None

    differences = differences[
        (differences > 0.001)
        &
        (differences < 0.2)
    ]

    if len(differences) < 10:

        return None

    median_interval = np.median(
        differences
    )

    if median_interval <= 0:

        return None

    fps = 1.0 / median_interval

    if fps < 5 or fps > 120:

        return None

    return float(fps)


# ============================================================
# FOREHEAD ROI
# ============================================================

def get_forehead_roi(frame, face_landmarks):
    """Locate both eyes, then place a wider pulse ROI above the eyebrows."""

    if frame is None or face_landmarks is None:
        return None

    h, w = frame.shape[:2]
    landmarks = face_landmarks.landmark

    try:
        # Eye contour landmarks from MediaPipe Face Mesh.
        eye_ids = [33, 133, 159, 145, 362, 263, 386, 374]
        eye_points = np.asarray([
            (int(landmarks[i].x * w), int(landmarks[i].y * h))
            for i in eye_ids
        ], dtype=np.int32)

        ex, ey, ew, eh = cv2.boundingRect(eye_points)

        # Include the full forehead width while keeping the ROI above the eyes.
        eye_center_x = ex + ew // 2
        roi_width = max(int(ew * 0.95), 50)
        roi_height = max(int(eh * 2.2), 24)

        x = eye_center_x - roi_width // 2
        y = ey - roi_height - max(4, int(eh * 0.25))

        x = max(0, x)
        y = max(0, y)
        x2 = min(w, x + roi_width)
        y2 = min(h, y + roi_height)

        # If the forehead ROI would be too short, reject it rather than
        # accidentally sampling the eyes.
        if x2 <= x or y2 <= y or (y2 - y) < int(roi_height * 0.65):
            return None

        roi = frame[y:y2, x:x2]
        if roi.size == 0:
            return None

        return roi, x, y, x2, y2, (ex, ey, ex + ew, ey + eh)

    except (IndexError, AttributeError, ValueError, TypeError):
        return None


# ============================================================
# GREEN SIGNAL
# ============================================================

def extract_green_value(roi):

    if roi is None:

        return None

    if roi.size == 0:

        return None

    green_channel = (
        roi[:, :, 1]
    )

    value = float(
        np.mean(
            green_channel
        )
    )

    if not np.isfinite(
        value
    ):

        return None

    return value


# ============================================================
# RGB SIGNAL (EXPERIMENTAL)
# ============================================================

def extract_rgb_values(roi):
    """Return mean red, green, and blue values from the forehead ROI."""

    if roi is None or roi.size == 0:
        return None

    # OpenCV frames use BGR channel order.
    means = np.mean(roi, axis=(0, 1))

    if len(means) < 3 or not np.isfinite(means[:3]).all():
        return None

    blue, green, red = map(float, means[:3])

    return {
        "red": red,
        "green": green,
        "blue": blue,
    }


# ============================================================
# VALID BPM
# ============================================================

def is_valid_bpm(bpm):

    if bpm is None:

        return False

    try:

        bpm = float(
            bpm
        )

    except Exception:

        return False

    if not np.isfinite(
        bpm
    ):

        return False

    if bpm < MIN_VALID_BPM:

        return False

    if bpm > MAX_VALID_BPM:

        return False

    return True


# ============================================================
# ADD BPM CANDIDATE
# ============================================================

def add_bpm_candidate(
    raw_bpm
):

    if not is_valid_bpm(
        raw_bpm
    ):

        return False

    raw_bpm = float(
        raw_bpm
    )

    candidates = (
        st.session_state.candidate_bpms
    )

    # ========================================================
    # JUMP REJECTION
    # ========================================================

    if len(candidates) >= 3:

        recent = candidates[
            -LOCK_WINDOW:
        ]

        recent_median = float(
            np.median(
                recent
            )
        )

        difference = abs(
            raw_bpm
            -
            recent_median
        )

        if difference > MAX_BPM_JUMP:

            print(
                "Rejected BPM jump: "
                f"{recent_median:.1f} "
                f"-> {raw_bpm:.1f}"
            )

            return False

    candidates.append(
        raw_bpm
    )

    if len(candidates) > 20:

        candidates.pop(0)

    return True


# ============================================================
# CHECK BPM LOCK
# ============================================================

def check_bpm_lock():

    candidates = (
        st.session_state.candidate_bpms
    )

    if len(candidates) < LOCK_WINDOW:

        return None

    recent = np.asarray(
        candidates[
            -LOCK_WINDOW:
        ],
        dtype=np.float64
    )

    if not np.all(
        np.isfinite(recent)
    ):

        return None

    median_bpm = float(
        np.median(
            recent
        )
    )

    deviation = float(
        np.std(
            recent
        )
    )

    bpm_range = float(
        np.ptp(
            recent
        )
    )

    print(
        "LOCK CHECK | "
        f"Values="
        f"{np.round(recent, 1).tolist()} | "
        f"Median={median_bpm:.1f} | "
        f"STD={deviation:.2f} | "
        f"Range={bpm_range:.1f}"
    )

    if deviation <= LOCK_STD_THRESHOLD:

        return round(
            median_bpm,
            1
        )

    return None


# ============================================================
# SIGNAL QUALITY
# ============================================================

def calculate_quality():

    signal = (
        st.session_state.signal_buffer
    )

    n = len(signal)

    if n == 0:

        return 0

    if n < 60:

        return 30

    if n < 120:

        return 50

    if n < MIN_SAMPLES:

        return 70

    arr = np.asarray(
        signal,
        dtype=np.float64
    )

    if len(arr) < 20:

        return 50

    # Remove overall trend before judging signal variation

    x = np.arange(
        len(arr),
        dtype=np.float64
    )

    try:

        coefficients = np.polyfit(
            x,
            arr,
            1
        )

        trend = np.polyval(
            coefficients,
            x
        )

        clean = (
            arr
            -
            trend
        )

    except Exception:

        clean = (
            arr
            -
            np.mean(arr)
        )

    std = float(
        np.std(clean)
    )

    if std < 0.05:

        return 35

    diff = np.diff(
        clean
    )

    if len(diff) == 0:

        return 40

    motion = float(
        np.std(diff)
    )

    relative_motion = (
        motion
        /
        (std + 1e-8)
    )

    if relative_motion < 0.30:

        return 95

    if relative_motion < 0.50:

        return 85

    if relative_motion < 0.75:

        return 70

    if relative_motion < 1.0:

        return 55

    return 35



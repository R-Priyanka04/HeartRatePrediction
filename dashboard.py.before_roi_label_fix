def get_bpm_status(bpm):
    """
    Return display category for BPM.
    """

    if bpm is None:
        return "WAITING"

    bpm = float(bpm)

    if bpm < 60:
        return "LOW"

    if bpm <= 100:
        return "NORMAL"

    return "HIGH"


